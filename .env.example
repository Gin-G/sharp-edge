# Sharp Edge — local development config

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///~/.sharp-edge/bets.db
# DATABASE_URL=postgresql://sharpedge:devpassword@localhost:5432/sharpedge

# FanDuel credentials
FANDUEL_EMAIL=
FANDUEL_PASSWORD=
FANDUEL_STATE=CO

# DraftKings
# Login and bet sync are not wired up yet — the request shapes still need
# capturing from a browser (see DRAFTKINGS_CAPTURE.md). DraftKings odds do
# work, via the aggregator below, because its own board is blocked by Akamai.
DRAFTKINGS_STATE=CO

# The Odds API — every book's prices through one licensed feed, which is how
# DraftKings gets priced. Free key at the-odds-api.com. Without one the
# multi-book board is simply absent and the FanDuel board is unaffected.
# Quota is the binding constraint: player props cost one credit per market per
# game, so narrowing ODDS_API_BOOKS is the cheapest way to cut spend.
ODDS_API_KEY=
ODDS_API_BOOKS=draftkings,fanduel,betmgm,caesars

# Anthropic API key (for chat panel)
ANTHROPIC_API_KEY=

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
