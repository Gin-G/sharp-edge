# Sharp Edge — local development config

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///~/.sharp-edge/bets.db
# DATABASE_URL=postgresql://sharpedge:devpassword@localhost:5432/sharpedge

# FanDuel credentials
FANDUEL_EMAIL=
FANDUEL_PASSWORD=
FANDUEL_STATE=CO

# Anthropic API key (for chat panel)
ANTHROPIC_API_KEY=

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
